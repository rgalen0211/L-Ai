                            "source": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "name": {
                                  "type": "string",
                                  "maxLength": 120,
                                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff\\ufff9-\\ufffb]*$"
                                },
                                "url": {
                                  "type": "string",
                                  "maxLength": 500,
                                  "pattern": "^https?://[!-~]{3,490}$"
                                }
                              },
                              "required": [
                                "name",
                                "url"
                              ]
                            },
                            "entity": {
                              "type": "string",
                              "maxLength": 40,
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,39}$"
                            },
                            "seconds": {
                              "type": "number",
                              "minimum": 0.5,
                              "maximum": 20.0
                            },
                            "position": {
                              "enum": [
                                "left-top",
                                "centre-top",
                                "right-top",
                                "left-middle",
                                "centre-middle",
                                "right-middle",
                                "left-bottom",
                                "centre-bottom",
                                "right-bottom"
                              ]
                            }
                          },
                          "required": [
                            "at",
                            "text",
                            "source"
                          ]
                        },
                        "minItems": 1,
                        "maxItems": 12
                      },
                      "shares_scale": {
                        "enum": [
                          "share",
                          "count"
                        ]
                      },
                      "shares_decimals": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3
                      },
                      "shares_order": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 40,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,39}$"
                        },
                        "minItems": 1,
                        "maxItems": 30
                      },
                      "shares_colors": {
                        "type": "object",
                        "propertyNames": {
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,39}$"
                        },
                        "additionalProperties": {
                          "type": "string",
                          "maxLength": 7,
                          "pattern": "^#[0-9a-fA-F]{6}$"
                        },
                        "maxProperties": 30
                      },
                      "shares_groups": {
                        "type": "object",
                        "propertyNames": {
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9 _.,&()+'-]{0,39}$"
                        },
                        "additionalProperties": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "maxLength": 40,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,39}$"
                          },
                          "minItems": 1,
                          "maxItems": 30
                        },
                        "maxProperties": 12
                      },
                      "network_base_groups": {
                        "type": "array",
                        "items": {
                          "enum": [
                            "dated_pre1956",
                            "dta_undated",
                            "shp_pre1956",
                            "shp_post1955",
                            "shp_unknown",
                            "shp_6b1"
                          ]
                        },
                        "minItems": 1,
                        "maxItems": 6
                      },
                      "network_base_label": {
                        "type": "string",
                        "maxLength": 120,
                        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff\\ufff9-\\ufffb]*$"
                      },
                      "network_readout_label": {
                        "type": "string",
                        "maxLength": 60,
                        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff\\ufff9-\\ufffb]*$"
                      },
                      "network_reveal": {
                        "enum": [
                          "milepost",
                          "fade"
                        ]
                      },
                      "network_context": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "layer": {
                            "enum": [
                              "tiger_prisecroads",
                              "ntad_nhpn"
                            ]
                          },
                          "classes": {
                            "type": "array",
                            "items": {
                              "enum": [
                                "S1100",
                                "S1200",
                                "U",
                                "S",
                                "I"
                              ]
                            },
                            "minItems": 1,
                            "maxItems": 5
                          },
                          "at": {
                            "type": "string",
                            "maxLength": 10,
                            "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
                          },
                          "fade_seconds": {
                            "type": "number",
                            "minimum": 0.1,
                            "maximum": 10.0
                          },
                          "label": {
                            "type": "string",
                            "maxLength": 120,
                            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff\\ufff9-\\ufffb]*$"
                          },
                          "credit": {
                            "type": "string",
                            "maxLength": 200,
                            "pattern": "^(?:[^{}\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff\\ufff9-\\ufffb]|\\{year\\})*$"
                          }
                        },
                        "required": [
                          "layer",
                          "at",
                          "fade_seconds",
                          "label"
                        ]
                      },
                      "final_hold_seconds": {
                        "type": "number",
                        "minimum": 1.6,
                        "maximum": 10.0
                      }
                    },
                    "required": []
                  },
                  "transition": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "enum": [
                          "cut",
                          "crossfade",
                          "fade"
                        ]
                      },
                      "seconds": {
                        "type": "number",
                        "minimum": 0.0,
                        "maximum": 3.0
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "dataset",
                  "view"
                ]
              }
            ]
          },
          "minItems": 1,
          "maxItems": 40
        }
      },
      "required": [
        "canvas",
        "fps",
        "theme",
        "clips"
      ]
    }
  },
  "required": [
    "schema",
    "name",
    "engine",
    "sequence"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ryagram-story-v1",
  "description": "Generated from ryagram/worker/schema.py by `python -m ryagram.worker.schema --write`; do not edit by hand. The worker re-validates every job; its check is authoritative.",
  "x-not-in-schema": [
    "the dataset allowlist and each dataset's offered views (the worker's config, not code)",
    "clip ids unique within a story",
    "start not after end, first_period not after last_period (same length)",
    "settings.line_band low not above high",
    "a title's headline or subhead not empty (the schema checks presence)",
    "network_base_groups needs a non-empty network_base_label; network_context.label, callout text and source names not empty",
    "callout ids unique within a clip",
    "what depends on the dataset or the run: a callout's period, entity, reading time and overlap; network_context.at; shares_order naming every band; the shares view only on a dataset with a composition",
    "free text: the worker tests Unicode categories (Cc, Cf, Cs, Co, Cn); the schema's pattern blocks the common ones only",
    "the story at most 256 KB, no duplicate keys, no NaN or Infinity",
    "brand and outro text: no link in any letter case (the pattern is case-sensitive), and brand.channel, brand.handle and brand.credit_line may not name the product (the 'Ryagram' rule, ryagram.profile.brand)"
  ]
}
