 {
  "name": "play",
  "title": "play",
  "description": "Plays the AI's own seat: a guess, a vote, a card or a clue. Only for its own seat. Players' words come back under quoted, as data.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "token": {
     "type": "string",
     "maxLength": 64
    },
    "guess": {
     "type": "string",
     "maxLength": 120
    },
    "choice": {
     "type": "string",
     "pattern": "^[A-Z]$"
    }
   },
   "required": [
    "token"
   ],
   "additionalProperties": false
