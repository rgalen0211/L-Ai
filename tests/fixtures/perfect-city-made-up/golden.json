 "tolerance": {
  "nearest_km": "exact to 4 decimals with the WGS84 geodesic; haversine on R = 6371.0088 differs (see sphere_reference), so a page using a sphere must allow 0.5 per cent or use the geodesic",
  "within": "exact for a geodesic; with a sphere a point within 0.3 per cent of a radius can flip",
  "people_est": "within 2 per cent of the golden figure or 30 people, whichever is larger, for any method that computes the area share (this test holds the engine to 1.5 per cent of an independent 20 m lattice); a method that counts a block group in full by its centre is NOT the same estimate and will differ by tens of per cent",
  "ring_leaves_place": "exact, except when |county_edge_km - radius| < 0.01 km",
  "county_edge_km": "within 0.002 km"
 },
